{
  "name": "@workbench-kit/contracts",
  "version": "0.0.2-prototype.0.2.6",
  "private": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "authoring-development": [
        "dist/authoring-development.d.ts"
      ],
      "external-node-catalog": [
        "dist/external-node-catalog.d.ts"
      ],
      "source-input-compatibility": [
        "dist/source-input-compatibility.d.ts"
      ],
      "theme-presets": [
        "dist/theme-presets.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm exec vitest run --config ../../vitest.config.ts src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./authoring-development": {
      "types": "./dist/authoring-development.d.ts",
      "import": "./dist/authoring-development.js",
      "require": "./dist/authoring-development.cjs",
      "default": "./dist/authoring-development.js"
    },
    "./external-node-catalog": {
      "types": "./dist/external-node-catalog.d.ts",
      "import": "./dist/external-node-catalog.js",
      "require": "./dist/external-node-catalog.cjs",
      "default": "./dist/external-node-catalog.js"
    },
    "./source-input-compatibility": {
      "types": "./dist/source-input-compatibility.d.ts",
      "import": "./dist/source-input-compatibility.js",
      "require": "./dist/source-input-compatibility.cjs",
      "default": "./dist/source-input-compatibility.js"
    },
    "./theme-presets": {
      "types": "./dist/theme-presets.d.ts",
      "import": "./dist/theme-presets.js",
      "require": "./dist/theme-presets.cjs",
      "default": "./dist/theme-presets.js"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx"
  ],
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "description": "Shared Workbench Kit contracts for chat, save, patch, library, launchpad mapping, widget renderer, and plugin flows.",
  "publishConfig": {
    "access": "public",
    "tag": "prototype",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewChoBo/workbench-kit.git",
    "directory": "packages/contracts"
  }
}
