{
  "name": "@workbench-kit/shell-react",
  "version": "0.0.2-prototype.0.2.6",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./field-remap": "./src/field-remap/index.ts",
    "./field-remap/view.css": "./src/field-remap/view.css",
    "./layout-storage": "./src/workbench/layout-storage.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx"
  ],
  "dependencies": {
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@workbench-kit/platform": "workspace:*",
    "@workbench-kit/react": "workspace:*",
    "@workbench-kit/field-remap": "workspace:*",
    "@workbench-kit/tokens": "workspace:*",
    "@workbench-kit/workbench-config": "workspace:*",
    "@workbench-kit/workbench-core": "workspace:*",
    "@workbench-kit/workbench-extension-sdk": "workspace:*",
    "@workbench-kit/workspace": "workspace:*",
    "@xyflow/react": "^12.11.2",
    "jsonata": "^2.2.0",
    "react-table-mapping": "^1.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "React shell and host assembly for Workbench Kit.",
  "publishConfig": {
    "access": "public",
    "tag": "prototype",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewChoBo/workbench-kit.git",
    "directory": "packages/shell-react"
  }
}
