{
  "name": "@workbench-kit/platform",
  "version": "0.0.2-prototype.0.2.6",
  "private": false,
  "type": "module",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "allowlisted-https-fetch": [
        "src/network/create-allowlisted-https-fetch.ts"
      ],
      "atomic-write": [
        "src/node/atomic-write.ts"
      ],
      "node": [
        "src/node/index.ts"
      ],
      "tray-close-policy": [
        "src/window/tray-close-policy.ts"
      ],
      "window-residency": [
        "src/window/window-residency.ts"
      ],
      "window-geometry": [
        "src/window/window-geometry.ts"
      ],
      "window-bounds-persistence": [
        "src/window/window-bounds-persistence.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./allowlisted-https-fetch": {
      "types": "./src/network/create-allowlisted-https-fetch.ts",
      "require": "./dist/allowlisted-https-fetch.cjs",
      "import": "./src/network/create-allowlisted-https-fetch.ts",
      "default": "./src/network/create-allowlisted-https-fetch.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "require": "./dist/node.cjs",
      "import": "./src/node/index.ts",
      "default": "./src/node/index.ts"
    },
    "./atomic-write": {
      "types": "./src/node/atomic-write.ts",
      "require": "./dist/atomic-write.cjs",
      "import": "./src/node/atomic-write.ts",
      "default": "./src/node/atomic-write.ts"
    },
    "./resize-rect": "./src/window/resize-rect.ts",
    "./tray-close-policy": {
      "types": "./src/window/tray-close-policy.ts",
      "require": "./dist/tray-close-policy.cjs",
      "import": "./src/window/tray-close-policy.ts",
      "default": "./src/window/tray-close-policy.ts"
    },
    "./versioned-browser-state": "./src/storage/versioned-browser-state.ts",
    "./window-bounds-persistence": {
      "types": "./src/window/window-bounds-persistence.ts",
      "require": "./dist/window-bounds-persistence.cjs",
      "import": "./src/window/window-bounds-persistence.ts",
      "default": "./src/window/window-bounds-persistence.ts"
    },
    "./window-residency": {
      "types": "./src/window/window-residency.ts",
      "require": "./dist/window-residency.cjs",
      "import": "./src/window/window-residency.ts",
      "default": "./src/window/window-residency.ts"
    },
    "./window-geometry": {
      "types": "./src/window/window-geometry.ts",
      "require": "./dist/window-geometry.cjs",
      "import": "./src/window/window-geometry.ts",
      "default": "./src/window/window-geometry.ts"
    }
  },
  "dependencies": {
    "@workbench-kit/base": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.5.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx"
  ],
  "description": "Framework-neutral command, menu, context-key, keybinding, and auth service contracts for Workbench Kit, plus optional Node-only persistence helpers via the /node subpath.",
  "publishConfig": {
    "access": "public",
    "tag": "prototype",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewChoBo/workbench-kit.git",
    "directory": "packages/platform"
  }
}
