{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./.tmp-types",
    "rootDir": "../src",
    "tsBuildInfoFile": "./.tmp-types/.tsbuildinfo"
  },
  "include": ["../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": [
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx",
    "../src/**/*.stories.ts",
    "../src/**/*.stories.tsx"
  ]
}
