{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench-kit.dev/schemas/architecture-research-record.schema.json",
  "title": "Architecture research record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "key",
    "lane",
    "question",
    "controlShas",
    "evidence",
    "verdict",
    "confidence",
    "nextQuestions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "key": { "type": "string", "minLength": 3 },
    "lane": { "type": "string", "minLength": 3 },
    "question": { "type": "string", "minLength": 10 },
    "controlShas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 7 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType", "title", "location", "accessedAt", "supports"],
        "properties": {
          "sourceType": {
            "enum": [
              "repository",
              "official_documentation",
              "standard",
              "original_paper",
              "vendor_release_note",
              "official_product_material"
            ]
          },
          "title": { "type": "string" },
          "location": { "type": "string" },
          "publishedOrVersionedAt": { "type": ["string", "null"] },
          "accessedAt": { "type": "string" },
          "supports": { "type": "string" }
        }
      }
    },
    "verdict": {
      "enum": ["maintain", "learn", "evolve", "improve", "retire", "not_applicable"]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "disconfirmingEvidence": { "type": "array", "items": { "type": "string" } },
    "nextQuestions": { "type": "array", "items": { "type": "string" } }
  }
}
