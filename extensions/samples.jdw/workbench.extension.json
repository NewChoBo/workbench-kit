      ]
    },
    "activities": [
      {
        "id": "workbench-kit.samples.jdw.activity",
        "viewContainerId": "jdwLab",
        "icon": "layout",
        "title": "JDW Lab",
        "order": 35
      }
    ],
    "views": {
      "jdwLab": [
        {
          "id": "workbench-kit.samples.jdw.panel",
          "name": "JDW Lab"
        }
      ]
    }
  }
